# HIVE PMO - the settings, as field names only.
#
# Copy this file to .env beside it and fill in every value.
# Every value is empty here on purpose: a value in this file would be a
# value in the repository. The lines starting with # say what each setting
# means; they are notes, never values.

# the name of the board's database
POSTGRES_DB=

# the account the database runs under
POSTGRES_USER=

# the database's password; the same one goes in DATABASE_URL
POSTGRES_PASSWORD=

# the address the board reaches its database on, postgresql://USER:PASSWORD@hive-db:5432/DB
DATABASE_URL=

# the port the board answers on, 3470 by default
PMO_PORT=

# the board's working folder inside the container, /var/lib/hive
PMO_HOME=

# how many times one card is sent back for repair before it stops and waits on its owner, 1 by default
HIVE_REPAIR_ROUNDS=

# how many stage runs may work at the same time
HIVE_HANDS=

# the same, within one column
HIVE_HANDS_PER_COLUMN=

# 0 turns the stage worker off entirely
HIVE_QUEEN=

# the address the board calls the switch on, http://host.docker.internal:3471 by default
HIVE_QUEEN_SWITCH=

# the harness program the stage worker starts, dsh on the PATH by default
DSH_BIN=

# the harness home the stage worker reads, ~/.dsh by default
DSH_HOME=
